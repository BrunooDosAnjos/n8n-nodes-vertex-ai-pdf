{
  "name": "@brunodosanjos/n8n-nodes-vertex-ai-pdf",
  "version": "1.2.0-beta.2",
  "description": "n8n community node for Google Vertex AI (Gemini)",
  "keywords": [
    "n8n-community-node-package",
    "vertex-ai",
    "gemini",
    "google-cloud",
    "ai"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pokabook/n8n-nodes-vertex-ai",
  "author": {
    "name": "pokabook"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BrunooDosAnjos/n8n-nodes-vertex-ai-pdf"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "build:ts": "tsc",
    "build:ts:watch": "tsc --watch",
    "reload:n8n": "npm run build:ts && docker restart n8n",
    "logs:n8n": "docker logs -f n8n",
    "dev": "nodemon -L --watch src --ext ts,json --exec \"npm run build:ts && docker restart n8n\"",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags && npm publish --access public",
    "release:minor": "npm version minor && git push --follow-tags && npm publish --access public",
    "release:major": "npm version major && git push --follow-tags && npm publish --access public"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VertexAiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/VertexAI/VertexAI.node.js"
    ]
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^8.56.0",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.69.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "jsonwebtoken": "^9.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.69.0"
  }
}
